<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.fs"/>
        <Content Include="Input/**" CopyToOutputDirectory="Always" TargetPath="Input/%(RecursiveDir)/%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
